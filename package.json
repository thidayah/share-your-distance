{
  "name": "share-your-distance",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:types": "supabase gen types typescript --linked > src/types/supabase.ts",
    "db:backup": "mkdir -p ../syd-db-backups/$(date +%F) && pg_dump -d \"$SUPABASE_DB_URL\" --schema-only --no-owner --no-privileges -f ../syd-db-backups/$(date +%F)/schema.sql",
    "db:apply": "psql \"$SUPABASE_DB_URL\" -v ON_ERROR_STOP=1 -f"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@react-email/components": "0.0.23",
    "@react-email/tailwind": "0.0.12",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.84.0",
    "bcryptjs": "^3.0.3",
    "crypto": "^1.0.1",
    "gsap": "^3.15.1",
    "midtrans-client": "^1.4.3",
    "next": "^16.0.7",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-toastify": "^11.0.5",
    "resend": "^6.4.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/midtrans-client": "^1.4.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.0.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
